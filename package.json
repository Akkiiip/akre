{
  "name": "akre-commerce-intelligence",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "format": "prettier --write src shared server tests docs *.json *.ts README.md .github/workflows/ci.yml",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs",
    "test:vercel": "node --test tests/vercel/function.test.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.4.2",
    "@neon/env": "^1.3.2",
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "lucide-react": "1.44.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tsx": "4.23.13",
    "ws": "^8.18.3",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
