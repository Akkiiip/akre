# Node >=24. Server-only; never prefix credentials with VITE_.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=data/akre.sqlite
AKRE_MODE=DEMO
# Required only for Vercel/serverless LIVE. Never use /tmp or local SQLite for LIVE.
DATABASE_URL=
# Required for LIVE mode and non-loopback hosting. Use a long random password.
AKRE_ADMIN_PASSWORD=
AKRE_SESSION_SECRET=
PUBLIC_ORIGIN=http://localhost:3001
SHOPIFY_SHOP=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
YOUTUBE_API_KEY=
